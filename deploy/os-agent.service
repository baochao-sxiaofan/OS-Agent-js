[Unit]
Description=OS-Agent server runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=os-agent
Group=os-agent
WorkingDirectory=/opt/os-agent
Environment=OS_AGENT_CONFIG=/etc/os-agent/server.config.json
EnvironmentFile=/etc/os-agent/runtime.env
ExecStart=/usr/bin/node /opt/os-agent/dist/server/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/os-agent /srv/os-agent/workspace

[Install]
WantedBy=multi-user.target
